# math.ylxc.top —— BetterMath 数学可视化静态站
#
# 与同机的 frontier-math / model-fingerprint / download 同一套做法：
#   80 只做跳转，443 走 Cloudflare 回源（源站证书 acme.sh DNS-01 签发）
#   内容是纯静态文件，没有上游服务：/var/www/bettermath 由本地
#   scripts/deploy.sh 用 rsync --delete 镜像 Vite 的 dist 产物

server {
    listen 80;
    listen [::]:80;
    server_name math.ylxc.top;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name math.ylxc.top;

    ssl_certificate     /etc/nginx/ssl/math.fullchain.crt;
    ssl_certificate_key /etc/nginx/ssl/math.key;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:MATHSL:10m;

    root /var/www/bettermath;
    index index.html;
    charset utf-8;

    # 全局 gzip 的 gzip_types 在本机是注释状态（只压 text/html），这里补上本站用到的类型
    gzip on;
    gzip_comp_level 6;
    gzip_min_length 512;
    gzip_types text/plain text/css application/javascript application/json image/svg+xml;

    # 静态文件走页缓存，1.6 GiB 的小机器上省一次 syscall 都是好的
    open_file_cache max=64 inactive=10m;
    open_file_cache_valid 60s;

    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header X-Frame-Options "SAMEORIGIN" always;

    # 入口页每次都要回源确认：文件名不带指纹，长缓存会把改版钉在 Cloudflare/浏览器里
    location = / {
        add_header Cache-Control "no-cache" always;
        add_header X-Content-Type-Options "nosniff" always;
    }

    location = /index.html {
        add_header Cache-Control "no-cache" always;
        add_header X-Content-Type-Options "nosniff" always;
    }

    # Vite 产物：文件名带内容哈希，可以长缓存
    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        add_header X-Content-Type-Options "nosniff" always;
        access_log off;
    }

    # 自托管字体同理（文件名固定，但字体内容一改就得换名，届时同步改 fonts.css）
    location /fonts/ {
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Access-Control-Allow-Origin "*" always;
        access_log off;
    }

    location = /favicon.svg {
        add_header Cache-Control "public, max-age=604800" always;
        add_header X-Content-Type-Options "nosniff" always;
    }

    # 单页站点：没有 SPA 路由，不存在的路径就该 404，不要回落到 index.html
    location / {
        try_files $uri $uri/ =404;
    }

    access_log /var/log/nginx/math.ylxc.top.access.log;
    error_log  /var/log/nginx/math.ylxc.top.error.log;
}